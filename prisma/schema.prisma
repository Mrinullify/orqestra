generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum DataSourceType {
    CSV
    EXCEL
}

enum ImportStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    PARTIALLY_COMPLETED
}

enum OrganizationRole {
    HR
    EMPLOYEE
}

model Organization {
    id             String          @id @default(cuid())
    name           String
    users          User[]
    dataSources    DataSource[]
    invitations    Invitation[]
    auditLogs      AuditLog[]
    actionApprovals ActionApproval[]
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
}

model User {
    id              String           @id @default(cuid())
    name            String?
    email           String           @unique
    passwordHash    String?
    isActive        Boolean          @default(false)
    department      String?
    role            OrganizationRole @default(EMPLOYEE)
    organizationId  String
    organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    sentInvitations Invitation[]     @relation("InvitedByUsers")
    auditLogs       AuditLog[]       @relation("AuditActor")
    actionApprovals ActionApproval[] @relation("ApprovalRequester")

    @@index([organizationId, role])
}

enum InvitationStatus {
    PENDING
    QUEUED
    PROCESSING
    SENT
    ACCEPTED
    EXPIRED
    REVOKED
    FAILED
}

model Invitation {
    id             String           @id @default(cuid())
    email          String
    role           OrganizationRole @default(EMPLOYEE)
    organizationId String
    organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    invitedById    String
    invitedBy      User             @relation("InvitedByUsers", fields: [invitedById], references: [id], onDelete: Cascade)
    tokenHash      String           @unique
    status         InvitationStatus @default(PENDING)
    failureReason  String?
    expiresAt      DateTime
    sentAt         DateTime?
    acceptedAt     DateTime?
    revokedAt      DateTime?
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    @@index([organizationId, email])
    @@index([status])
}

model AuditLog {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    actorId        String?
    actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
    action         String
    resourceType   String
    resourceId     String?
    metadata       Json?
    success        Boolean      @default(true)
    requestId      String
    createdAt      DateTime     @default(now())

    @@index([organizationId, createdAt])
    @@index([organizationId, action, createdAt])
    @@index([organizationId, resourceType, resourceId])
    @@index([requestId])
}

enum ActionApprovalStatus {
    PENDING
    APPROVED
    REJECTED
    EXPIRED
    EXECUTED
}

model ActionApproval {
    id             String               @id @default(cuid())
    organizationId String
    organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    requestedById  String
    requestedBy    User                 @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
    action         String
    resourceType   String
    resourceId     String?
    payload        Json?
    status         ActionApprovalStatus @default(PENDING)
    expiresAt      DateTime
    approvedAt     DateTime?
    executedAt     DateTime?
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt

    @@index([organizationId, status, createdAt])
    @@index([organizationId, requestedById, status])
}

model DataSource {
    id             String         @id @default(cuid())
    name           String
    originalName   String
    type           DataSourceType
    mimeType       String?
    sizeBytes      BigInt?
    storageKey     String
    organizationId String
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    imports        DataImport[]
    records        DataRecord[]
    createdAt      DateTime       @default(now())
    updatedAt      DateTime         @updatedAt

    @@index([organizationId])
}

model DataImport {
    id             String          @id @default(cuid())
    dataSourceId   String
    dataSource     DataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
    status         ImportStatus    @default(PENDING)
    totalRows      Int?
    acceptedRows   Int             @default(0)
    rejectedRows   Int             @default(0)
    errorDetails   Json?
    startedAt      DateTime?
    completedAt    DateTime?
    columnMappings ColumnMapping[]
    records        DataRecord[]
    createdAt      DateTime        @default(now())

    @@index([dataSourceId, createdAt])
    @@index([status])
}

model ColumnMapping {
    id             String     @id @default(cuid())
    dataImportId   String
    dataImport     DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
    originalName   String
    normalizedName String
    detectedType   String?
    confidence     Float?
    isApproved     Boolean    @default(false)
    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt

    @@unique([dataImportId, originalName])
    @@index([dataImportId])
}
model DataRecord {
    id             String     @id @default(cuid())
    organizationId String
    dataSourceId   String
    dataImportId   String
    rowNumber      Int
    data           Json
    createdAt      DateTime   @default(now())
    dataSource     DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
    dataImport     DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)

    @@unique([dataImportId, rowNumber])
    @@index([organizationId, dataSourceId])
    @@index([organizationId, dataImportId])
}
