generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum DataSourceType {
    CSV
    EXCEL
}

enum ImportStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    PARTIALLY_COMPLETED
}

enum OrganizationRole {
    HR
    EMPLOYEE
}

model Organization {
    id          String       @id @default(cuid())
    name        String
    users       User[]
    dataSources DataSource[]
    invitations Invitation[]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
}

model User {
    id              String           @id @default(cuid())
    name            String?
    email           String           @unique
    passwordHash    String?
    isActive        Boolean          @default(false)
    department      String?
    role            OrganizationRole @default(EMPLOYEE)
    organizationId  String
    organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    sentInvitations Invitation[]     @relation("InvitedByUsers")

    @@index([organizationId, role])
}

enum InvitationStatus {
    PENDING
    QUEUED
    PROCESSING
    SENT
    ACCEPTED
    EXPIRED
    REVOKED
    FAILED
}

model Invitation {
    id             String           @id @default(cuid())
    email          String
    role           OrganizationRole @default(EMPLOYEE)
    organizationId String
    organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    invitedById    String
    invitedBy      User             @relation("InvitedByUsers", fields: [invitedById], references: [id], onDelete: Cascade)
    tokenHash      String           @unique
    status         InvitationStatus @default(PENDING)
    failureReason  String?
    expiresAt      DateTime
    sentAt         DateTime?
    acceptedAt     DateTime?
    revokedAt      DateTime?
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    @@index([organizationId, email])
    @@index([status])
}

model DataSource {
    id             String         @id @default(cuid())
    name           String
    originalName   String
    type           DataSourceType
    mimeType       String?
    sizeBytes      BigInt?
    storageKey     String
    organizationId String
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    imports        DataImport[]
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    @@index([organizationId])
}

model DataImport {
    id             String          @id @default(cuid())
    dataSourceId   String
    dataSource     DataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
    status         ImportStatus    @default(PENDING)
    totalRows      Int?
    acceptedRows   Int             @default(0)
    rejectedRows   Int             @default(0)
    errorDetails   Json?
    startedAt      DateTime?
    completedAt    DateTime?
    columnMappings ColumnMapping[]
    createdAt      DateTime        @default(now())

    @@index([dataSourceId, createdAt])
    @@index([status])
}

model ColumnMapping {
    id             String     @id @default(cuid())
    dataImportId   String
    dataImport     DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
    originalName   String
    normalizedName String
    detectedType   String?
    confidence     Float?
    isApproved     Boolean    @default(false)
    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt

    @@unique([dataImportId, originalName])
    @@index([dataImportId])
}
